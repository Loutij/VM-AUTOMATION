# =============================================================================
# VM Automation - Configuration Environment
# =============================================================================
# Copier ce fichier vers .env et remplir les valeurs
# NE JAMAIS COMMITER LE FICHIER .env AVEC DES VRAIES VALEURS
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=vm-automation
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-super-secret-key-change-in-production
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Database - PostgreSQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vmautomation
DB_USER=vmautomation
DB_PASSWORD=your-db-password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Hyper-V Configuration
# -----------------------------------------------------------------------------
HYPERV_HOST=hyperv-server.domain.local
HYPERV_USER=DOMAIN\\administrator
HYPERV_PASSWORD=your-hyperv-password
HYPERV_USE_SSL=true
HYPERV_VM_PATH=D:\\HyperV\\VirtualMachines
HYPERV_VHDX_PATH=D:\\HyperV\\VirtualHardDisks
HYPERV_ISO_PATH=D:\\HyperV\\ISOs
HYPERV_DEFAULT_SWITCH=External-Switch

# -----------------------------------------------------------------------------
# Active Directory (Optionnel)
# -----------------------------------------------------------------------------
AD_ENABLED=false
AD_DOMAIN=domain.local
AD_USER=DOMAIN\\svc-vmautomation
AD_PASSWORD=your-ad-password
AD_DEFAULT_OU=OU=VMs-Automatisees,DC=domain,DC=local
AD_DNS_SERVER=192.168.1.10

# -----------------------------------------------------------------------------
# Installation OS
# -----------------------------------------------------------------------------
DEFAULT_ADMIN_PASSWORD=TempP@ss123!
DEFAULT_TIMEZONE=Europe/Paris
DEFAULT_LOCALE=fr-FR

# -----------------------------------------------------------------------------
# Performance
# -----------------------------------------------------------------------------
MAX_CONCURRENT_DEPLOYMENTS=5
VM_CREATION_TIMEOUT=300
OS_INSTALL_TIMEOUT=3600
POST_INSTALL_TIMEOUT=1800

# -----------------------------------------------------------------------------
# Email SMTP (Notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=noreply@yourcompany.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourcompany.com
SMTP_ENABLED=false
