# =============================================================================
# VM Automation - Configuration Environment
# =============================================================================
# Copier ce fichier vers .env et remplir les valeurs
# NE JAMAIS COMMITER LE FICHIER .env AVEC DES VRAIES VALEURS
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=vm-automation
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-super-secret-key-change-in-production
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# -----------------------------------------------------------------------------
# Database - PostgreSQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vmautomation
DB_USER=vmautomation
DB_PASSWORD=your-db-password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Hyper-V Configuration
# -----------------------------------------------------------------------------
HYPERV_HOST=hyperv-server.domain.local
HYPERV_USER=DOMAIN\\administrator
HYPERV_PASSWORD=your-hyperv-password
HYPERV_USE_SSL=true
HYPERV_VM_PATH=D:\\HyperV\\VirtualMachines
HYPERV_VHDX_PATH=D:\\HyperV\\VirtualHardDisks
HYPERV_ISO_PATH=D:\\HyperV\\ISOs
HYPERV_TEMP_PATH=D:\\HyperV\\Temp
HYPERV_UNATTEND_PATH=D:\\HyperV\\Unattend
HYPERV_DEFAULT_SWITCH=External-Switch
# Chemin vers oscdimg.exe sur l'hôte Hyper-V (outil ADK pour remaster ISO)
OSCDIMG_PATH=C:\Program Files (x86)\Windows Kits\10\Assessment and Deployment Kit\Deployment Tools\amd64\Oscdimg\oscdimg.exe

# =============================================================================
# VMware ESXi / vSphere (optional)
# =============================================================================
# ESXI_HOST=192.168.1.100
# ESXI_PORT=443
# ESXI_USER=root
# ESXI_PASSWORD=changeme
# ESXI_USE_SSL=true
# ESXI_VERIFY_SSL=false
# ESXI_DATACENTER=dc1
# ESXI_CLUSTER=cluster1
# ESXI_DEFAULT_DATASTORE=datastore1
# ESXI_DEFAULT_RESOURCE_POOL=
# ESXI_VM_FOLDER=
# ESXI_ISO_DATASTORE=datastore1
# ESXI_ISO_PATH=ISOs

# -----------------------------------------------------------------------------
# Active Directory (Optionnel)
# -----------------------------------------------------------------------------
AD_ENABLED=false
AD_DOMAIN=domain.local
AD_USER=DOMAIN\\svc-vmautomation
AD_PASSWORD=your-ad-password
AD_DEFAULT_OU=OU=VMs-Automatisees,DC=domain,DC=local
AD_DNS_SERVER=192.168.1.10

# -----------------------------------------------------------------------------
# Installation OS
# -----------------------------------------------------------------------------
DEFAULT_ADMIN_PASSWORD=tooroto
DEFAULT_TIMEZONE=Europe/Paris
DEFAULT_LOCALE=fr-FR

# -----------------------------------------------------------------------------
# Performance
# -----------------------------------------------------------------------------
MAX_CONCURRENT_DEPLOYMENTS=5
VM_CREATION_TIMEOUT=300
OS_INSTALL_TIMEOUT=3600
POST_INSTALL_TIMEOUT=1800

# -----------------------------------------------------------------------------
# Email SMTP (Notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=maintenance.infra@oto-technology.fr
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=maintenance.infra@oto-technology.fr
SMTP_ENABLED=true
# Adresse email de notification par défaut (reçoit toutes les notifications de déploiement, même sans compte utilisateur)
NOTIFICATION_EMAIL=admin@yourcompany.com

# -----------------------------------------------------------------------------
# VNC Configuration
# -----------------------------------------------------------------------------
VNC_DEFAULT_PORT=5900
VNC_MAX_SESSIONS=10
VNC_SESSION_TIMEOUT=3600
VNC_PROXY_ENABLED=true

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# ENCRYPTION_KEY=          # Auto-generated if not set. Set for persistence across restarts.

# -----------------------------------------------------------------------------
# Flower (Celery monitoring)
# -----------------------------------------------------------------------------
# IMPORTANT: Change this password in production!
FLOWER_PASSWORD=changeme
