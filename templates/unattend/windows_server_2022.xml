<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
    <!-- =================================================================== -->
    <!-- Windows Server 2022 - Unattended Installation Template              -->
    <!-- Variables Jinja2: {{ variable_name }}                               -->
    <!-- =================================================================== -->

    <!-- ================================================================== -->
    <!-- Phase 1: windowsPE - Configuration initiale du disque              -->
    <!-- ================================================================== -->
    <settings pass="windowsPE">
        <component name="Microsoft-Windows-International-Core-WinPE" 
                   processorArchitecture="amd64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS">
            <SetupUILanguage>
                <UILanguage>{{ locale | default('fr-FR') }}</UILanguage>
            </SetupUILanguage>
            <InputLocale>{{ keyboard_layout | default('040c:0000040c') }}</InputLocale>
            <SystemLocale>{{ locale | default('fr-FR') }}</SystemLocale>
            <UILanguage>{{ locale | default('fr-FR') }}</UILanguage>
            <UserLocale>{{ locale | default('fr-FR') }}</UserLocale>
        </component>

        <component name="Microsoft-Windows-Setup" 
                   processorArchitecture="amd64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS">
            
            <!-- Configuration du disque -->
            <DiskConfiguration>
                <Disk wcm:action="add">
                    <DiskID>0</DiskID>
                    <WillWipeDisk>true</WillWipeDisk>
                    <CreatePartitions>
                        <!-- Partition EFI -->
                        <CreatePartition wcm:action="add">
                            <Order>1</Order>
                            <Size>500</Size>
                            <Type>EFI</Type>
                        </CreatePartition>
                        <!-- Partition MSR -->
                        <CreatePartition wcm:action="add">
                            <Order>2</Order>
                            <Size>128</Size>
                            <Type>MSR</Type>
                        </CreatePartition>
                        <!-- Partition Windows -->
                        <CreatePartition wcm:action="add">
                            <Order>3</Order>
                            <Extend>true</Extend>
                            <Type>Primary</Type>
                        </CreatePartition>
                    </CreatePartitions>
                    <ModifyPartitions>
                        <ModifyPartition wcm:action="add">
                            <Order>1</Order>
                            <PartitionID>1</PartitionID>
                            <Format>FAT32</Format>
                            <Label>System</Label>
                        </ModifyPartition>
                        <ModifyPartition wcm:action="add">
                            <Order>2</Order>
                            <PartitionID>2</PartitionID>
                        </ModifyPartition>
                        <ModifyPartition wcm:action="add">
                            <Order>3</Order>
                            <PartitionID>3</PartitionID>
                            <Format>NTFS</Format>
                            <Label>Windows</Label>
                            <Letter>C</Letter>
                        </ModifyPartition>
                    </ModifyPartitions>
                </Disk>
            </DiskConfiguration>

            <!-- Sélection de l'image à installer -->
            <ImageInstall>
                <OSImage>
                    <InstallFrom>
                        <MetaData wcm:action="add">
                            <Key>/IMAGE/NAME</Key>
                            <Value>{{ windows_edition | default('Windows Server 2022 SERVERSTANDARD') }}</Value>
                        </MetaData>
                    </InstallFrom>
                    <InstallTo>
                        <DiskID>0</DiskID>
                        <PartitionID>3</PartitionID>
                    </InstallTo>
                </OSImage>
            </ImageInstall>

            <!-- Clé produit (optionnel) -->
            {% if product_key %}
            <UserData>
                <ProductKey>
                    <Key>{{ product_key }}</Key>
                </ProductKey>
                <AcceptEula>true</AcceptEula>
            </UserData>
            {% else %}
            <UserData>
                <AcceptEula>true</AcceptEula>
            </UserData>
            {% endif %}
        </component>
    </settings>

    <!-- ================================================================== -->
    <!-- Phase 4: specialize - Configuration réseau et machine              -->
    <!-- ================================================================== -->
    <settings pass="specialize">
        <component name="Microsoft-Windows-Shell-Setup" 
                   processorArchitecture="amd64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS">
            <ComputerName>{{ hostname | default('WIN-VM') }}</ComputerName>
            <TimeZone>{{ timezone | default('Romance Standard Time') }}</TimeZone>
        </component>

        <component name="Microsoft-Windows-TerminalServices-LocalSessionManager" 
                   processorArchitecture="amd64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS">
            <fDenyTSConnections>false</fDenyTSConnections>
        </component>

        <component name="Networking-MPSSVC-Svc" 
                   processorArchitecture="amd64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS">
            <FirewallGroups>
                <FirewallGroup wcm:action="add" wcm:keyValue="RemoteDesktop">
                    <Active>true</Active>
                    <Group>Remote Desktop</Group>
                    <Profile>all</Profile>
                </FirewallGroup>
            </FirewallGroups>
        </component>

        {% if static_ip %}
        <component name="Microsoft-Windows-TCPIP" 
                   processorArchitecture="amd64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS">
            <Interfaces>
                <Interface wcm:action="add">
                    <Identifier>Ethernet</Identifier>
                    <Ipv4Settings>
                        <DhcpEnabled>false</DhcpEnabled>
                    </Ipv4Settings>
                    <UnicastIpAddresses>
                        <IpAddress wcm:action="add" wcm:keyValue="1">{{ ip_address }}/{{ subnet_prefix | default('24') }}</IpAddress>
                    </UnicastIpAddresses>
                    <Routes>
                        <Route wcm:action="add">
                            <Identifier>0</Identifier>
                            <NextHopAddress>{{ gateway }}</NextHopAddress>
                            <Prefix>0.0.0.0/0</Prefix>
                        </Route>
                    </Routes>
                </Interface>
            </Interfaces>
        </component>
        <component name="Microsoft-Windows-DNS-Client" 
                   processorArchitecture="amd64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS">
            <Interfaces>
                <Interface wcm:action="add">
                    <Identifier>Ethernet</Identifier>
                    <DNSServerSearchOrder>
                        <IpAddress wcm:action="add" wcm:keyValue="1">{{ dns_server_1 | default('8.8.8.8') }}</IpAddress>
                        {% if dns_server_2 %}
                        <IpAddress wcm:action="add" wcm:keyValue="2">{{ dns_server_2 }}</IpAddress>
                        {% endif %}
                    </DNSServerSearchOrder>
                </Interface>
            </Interfaces>
        </component>
        {% endif %}
    </settings>

    <!-- ================================================================== -->
    <!-- Phase 7: oobeSystem - Configuration utilisateur et OOBE            -->
    <!-- ================================================================== -->
    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-Shell-Setup" 
                   processorArchitecture="amd64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS">
            
            <OOBE>
                <HideEULAPage>true</HideEULAPage>
                <HideLocalAccountScreen>true</HideLocalAccountScreen>
                <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
                <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
                <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
                <NetworkLocation>Work</NetworkLocation>
                <ProtectYourPC>3</ProtectYourPC>
                <SkipMachineOOBE>true</SkipMachineOOBE>
                <SkipUserOOBE>true</SkipUserOOBE>
            </OOBE>

            <UserAccounts>
                <AdministratorPassword>
                    <Value>{{ admin_password | default('TempP@ss123!') }}</Value>
                    <PlainText>true</PlainText>
                </AdministratorPassword>
                {% if local_users %}
                <LocalAccounts>
                    {% for user in local_users %}
                    <LocalAccount wcm:action="add">
                        <Password>
                            <Value>{{ user.password }}</Value>
                            <PlainText>true</PlainText>
                        </Password>
                        <Description>{{ user.description | default('') }}</Description>
                        <DisplayName>{{ user.display_name | default(user.name) }}</DisplayName>
                        <Group>{{ user.group | default('Administrators') }}</Group>
                        <Name>{{ user.name }}</Name>
                    </LocalAccount>
                    {% endfor %}
                </LocalAccounts>
                {% endif %}
            </UserAccounts>

            <AutoLogon>
                <Password>
                    <Value>{{ admin_password | default('TempP@ss123!') }}</Value>
                    <PlainText>true</PlainText>
                </Password>
                <Enabled>true</Enabled>
                <LogonCount>1</LogonCount>
                <Username>Administrateur</Username>
            </AutoLogon>

            <!-- Script de premier démarrage -->
            <FirstLogonCommands>
                <!-- Définir le mot de passe Administrateur explicitement (Windows FR) -->
                <SynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <CommandLine>cmd /c net user Administrateur "{{ admin_password | default('TempP@ss123!') }}" /active:yes</CommandLine>
                    <Description>Set Administrateur password</Description>
                </SynchronousCommand>
                <!-- Activer WinRM pour l'administration à distance -->
                <SynchronousCommand wcm:action="add">
                    <Order>2</Order>
                    <CommandLine>powershell -Command "Enable-PSRemoting -Force -SkipNetworkProfileCheck"</CommandLine>
                    <Description>Enable PowerShell Remoting</Description>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>3</Order>
                    <CommandLine>powershell -Command "Set-Item WSMan:\localhost\Client\TrustedHosts -Value '*' -Force"</CommandLine>
                    <Description>Configure WinRM TrustedHosts</Description>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>4</Order>
                    <CommandLine>powershell -Command "winrm quickconfig -quiet"</CommandLine>
                    <Description>Quick configure WinRM</Description>
                </SynchronousCommand>
                <!-- Configurer le profil réseau sur Privé pour activer la découverte -->
                <SynchronousCommand wcm:action="add">
                    <Order>5</Order>
                    <CommandLine>powershell -Command "Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private"</CommandLine>
                    <Description>Set network profile to Private</Description>
                </SynchronousCommand>
                <!-- Activer la découverte réseau -->
                <SynchronousCommand wcm:action="add">
                    <Order>6</Order>
                    <CommandLine>netsh advfirewall firewall set rule group="Network Discovery" new enable=Yes</CommandLine>
                    <Description>Enable Network Discovery</Description>
                </SynchronousCommand>
                <!-- Activer le partage de fichiers et imprimantes -->
                <SynchronousCommand wcm:action="add">
                    <Order>7</Order>
                    <CommandLine>netsh advfirewall firewall set rule group="File and Printer Sharing" new enable=Yes</CommandLine>
                    <Description>Enable File and Printer Sharing</Description>
                </SynchronousCommand>
                {% if join_domain %}
                <SynchronousCommand wcm:action="add">
                    <Order>8</Order>
                    <CommandLine>powershell -Command "Add-Computer -DomainName '{{ domain_name }}' -Credential (New-Object PSCredential('{{ domain_user }}', (ConvertTo-SecureString '{{ domain_password }}' -AsPlainText -Force))) -OUPath '{{ domain_ou | default('') }}' -Restart"</CommandLine>
                    <Description>Join Active Directory Domain</Description>
                </SynchronousCommand>
                {% endif %}
                {% for cmd in post_install_commands | default([]) %}
                <SynchronousCommand wcm:action="add">
                    <Order>{{ loop.index + 20 }}</Order>
                    <CommandLine>{{ cmd.command }}</CommandLine>
                    <Description>{{ cmd.description | default('Custom command') }}</Description>
                </SynchronousCommand>
                {% endfor %}
            </FirstLogonCommands>
        </component>

        <component name="Microsoft-Windows-International-Core" 
                   processorArchitecture="amd64" 
                   publicKeyToken="31bf3856ad364e35" 
                   language="neutral" 
                   versionScope="nonSxS">
            <InputLocale>{{ keyboard_layout | default('040c:0000040c') }}</InputLocale>
            <SystemLocale>{{ locale | default('fr-FR') }}</SystemLocale>
            <UILanguage>{{ locale | default('fr-FR') }}</UILanguage>
            <UserLocale>{{ locale | default('fr-FR') }}</UserLocale>
        </component>
    </settings>
</unattend>
